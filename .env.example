# Copy this file to .env only if you want to change a default. The app runs without it.

# Where the web app listens.
PORT=3000

# The local PostgreSQL created by "npm run db:setup".
DATABASE_URL=postgresql://postgres@127.0.0.1:55432/mandate

# Optional. Leave this unset and Mandate answers extractively: it quotes sentences
# from your documents verbatim. That cannot invent a number, so it is the safe default.
#
# Set a key to get fluent prose instead. Answers are still restricted to retrieved
# passages, every claim must cite one, and any figure that does not appear in the
# cited text causes the generated answer to be thrown away and the quote used instead.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Largest single upload, in bytes. Default 60 MB.
# MAX_UPLOAD_BYTES=62914560
